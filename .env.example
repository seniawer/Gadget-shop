# Токен бота от @BotFather (никогда не коммитить!)
BOT_TOKEN=
# Куда бот присылает заказы и заявки на ремонт: Telegram ID или ID группы менеджеров
ADMIN_CHAT_ID=
# Telegram ID администраторов через запятую, например 123456789,987654321.
# Если пусто, админом считается владелец из ADMIN_CHAT_ID.
ADMIN_IDS=
# Адрес мини-аппа, например https://gadget-shop-miniapp.netlify.app
WEBAPP_URL=
# Случайная строка для защиты вебхука бота (необязательно)
WEBHOOK_SECRET=
